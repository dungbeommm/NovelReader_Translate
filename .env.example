# Optional settings for local FastAPI. MoLab configures its own runtime.
# PIPER_DEVICE: auto | cpu | cuda | openvino (Intel GPU; install openvino first)
PIPER_DEVICE=auto
PIPER_REQUIRE_CUDA=0
HACHIMIMT_WEB_BATCH_SIZE=8
# Intel Arc: install the XPU environment, select Transformers in WebUI, then
# set this before starting Python. Tested: torch 2.12.0+xpu, FP16, Arc 130T.
# HACHIMIMT_TORCH_DEVICE=xpu

# Hugging Face Bucket, configurable per runtime
# Backend-only token with write access; never include in a shared backup
HF_TOKEN=

# Optional VieNeu: install via scripts/setup_tts.py first
# NOVEL_TTS_ENGINE=vieneu
# NOVEL_TTS_VOICE=truc_ly
# VIENEU_DEVICE=auto
# VIENEU_MODEL_DIR=/path/to/models/vieneu
