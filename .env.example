PIPER_DEVICE=auto
PIPER_REQUIRE_CUDA=0
HACHIMIMT_WEB_BATCH_SIZE=8

# Optional: backend-only Pixeldrain key (never include in a shared backup)
PIXELDRAIN_API_KEY=

