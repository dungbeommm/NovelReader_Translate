# Optional Web/CPU settings. Colab notebook sets its own GPU configuration.
# PIPER_DEVICE: auto | cpu | cuda
PIPER_DEVICE=auto
PIPER_REQUIRE_CUDA=0
HACHIMIMT_WEB_BATCH_SIZE=8

# Hugging Face Storage Bucket (private by default; never commit HF_TOKEN)
HF_TOKEN=
HF_USERNAME=
HF_BUCKET_ID=
NOVELREADER_PRIVATE_CONFIG=~/.config/novelreader/private.json

# MoLab restores only a verified local/source bundle; it does not fetch and run
# an arbitrary GitHub branch.
NOVELREADER_SOURCE_BUNDLE=
CLOUDFLARED_BIN=cloudflared
NOVEL_ENABLE_LEGACY_EXPORTS=0

# Optional: backend-only Pixeldrain key (never include in a shared backup)
PIXELDRAIN_API_KEY=

# Optional VieNeu: install via scripts/setup_tts.py first
# NOVEL_TTS_ENGINE=vieneu
# NOVEL_TTS_VOICE=truc_ly
# VIENEU_DEVICE=auto
# VIENEU_MODEL_DIR=/path/to/models/vieneu
