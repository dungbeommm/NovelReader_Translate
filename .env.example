# Optional Web/CPU settings. Colab notebook sets its own GPU configuration.
# PIPER_DEVICE: auto | cpu | cuda
PIPER_DEVICE=auto
PIPER_REQUIRE_CUDA=0
HACHIMIMT_WEB_BATCH_SIZE=8

# Hugging Face storage: uri410/novelreader-storage (dataset, fixed)
# Backend-only token with write access; never include in a shared backup
HF_TOKEN=

